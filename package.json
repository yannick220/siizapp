{
  "name": "siizapp-pwa",
  "version": "1.0.0",
  "private": true,
  "description": "SIIZ PWA package for GitHub Pages, Supabase and Capacitor.",
  "scripts": {
    "serve": "npx serve .",
    "cap:init": "npx cap init SIIZ app.siiz.mobile --web-dir .",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "serve": "^14.2.4"
  }
}
